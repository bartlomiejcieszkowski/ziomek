// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/vscode_extension"
			],
			"outFiles": [
				"${workspaceFolder}/vscode_extension/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			"name": "Python: TTS Accuracy Benchmark",
			"type": "debugpy",
			"request": "launch",
			"module": "ziomek",
			"args": ["benchmark", "run", "tts"],
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Python: TTS Accuracy Benchmark Verbose",
			"type": "debugpy",
			"request": "launch",
			"module": "ziomek",
			"args": ["-v", "benchmark", "run", "tts"],
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Python: STT Quality Benchmark",
			"type": "debugpy",
			"request": "launch",
			"module": "ziomek",
			"args": ["benchmark", "run", "stt"],
			"console": "integratedTerminal",
			"justMyCode": false
		},
		{
			"name": "Python: Ziomek Server",
			"type": "debugpy",
			"request": "launch",
			"module": "ziomek",
			"args": ["server", "--dev", "--verbose"],
			"console": "integratedTerminal",
			"justMyCode": false
		}
	]
}
